{
  "name": "parcelcontext",
  "displayName": "ParcelContext",
  "description": "Export, import, and share reviewed Copilot context across workspaces and teammates.",
  "version": "0.9.3",
  "publisher": "hackathon2026",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "ParcelContext",
      "properties": {
        "parcelcontext.scan.useModel": {
          "type": "boolean",
          "default": true,
          "description": "Use a language model to name topics and refine sections when scanning chat history. When off, ParcelContext falls back to local heuristics, which are faster but name topics after whatever was typed first."
        },
        "parcelcontext.scan.model": {
          "type": "string",
          "default": "",
          "description": "Model id to use for scanning. Leave empty to choose automatically, which prefers MAI models. Run \"ParcelContext: Select Model For Scanning\" to pick from the models available to you."
        },
        "parcelcontext.scan.reasoningEffort": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "low",
            "medium",
            "high"
          ],
          "enumDescriptions": [
            "Let the model decide. Fastest, and correct for most scans.",
            "Minimal reasoning. Quickest naming, weakest section rewriting.",
            "Balanced. Useful when topics overlap heavily.",
            "Most thorough deduplication and rewriting. Noticeably slower."
          ],
          "description": "Reasoning effort requested when scanning. Passed through as a model option, so models that do not support it ignore the setting."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "parcelcontext",
          "title": "ParcelContext",
          "icon": "$(library)"
        }
      ]
    },
    "views": {
      "parcelcontext": [
        {
          "id": "parcelcontext.library",
          "name": "Context Library"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "parcelcontext.library",
        "contents": "No context packs yet.\n\nBuild packs from the chat history already on this machine.\n[Scan for packs](command:parcelcontext.scanPacks)\n[Build a pack from a topic](command:parcelcontext.buildPackFromTopic)\n[Save from this workspace](command:parcelcontext.savePack)\n[Import a pack](command:parcelcontext.importPack)\n\nScanning uses a language model to name topics and tidy up what it extracts.\n[Choose model and effort](command:parcelcontext.selectModel)"
      }
    ],
    "commands": [
      {
        "command": "parcelcontext.newPack",
        "title": "ParcelContext: New Context Pack",
        "icon": "$(add)"
      },
      {
        "command": "parcelcontext.searchPacks",
        "title": "ParcelContext: Search Packs",
        "icon": "$(search)"
      },
      {
        "command": "parcelcontext.buildPackFromTopic",
        "title": "ParcelContext: Build A Pack From A Topic",
        "icon": "$(lightbulb)"
      },
      {
        "command": "parcelcontext.selectModel",
        "title": "ParcelContext: Select Model For Scanning",
        "icon": "$(sparkle)"
      },
      {
        "command": "parcelcontext.showVersion",
        "title": "ParcelContext: Show Version And Diagnostics"
      },
      {
        "command": "parcelcontext.savePack",
        "title": "ParcelContext: Save Context Pack",
        "icon": "$(add)"
      },
      {
        "command": "parcelcontext.scanPacks",
        "title": "ParcelContext: Scan Chat History For Packs",
        "icon": "$(telescope)"
      },
      {
        "command": "parcelcontext.splitPack",
        "title": "ParcelContext: Split Pack",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "parcelcontext.mergePacks",
        "title": "ParcelContext: Merge Packs",
        "icon": "$(merge)"
      },
      {
        "command": "parcelcontext.refreshPack",
        "title": "ParcelContext: Refresh Pack From Workspace",
        "icon": "$(sync)"
      },
      {
        "command": "parcelcontext.listPacks",
        "title": "ParcelContext: List Context Packs",
        "icon": "$(list-unordered)"
      },
      {
        "command": "parcelcontext.exportPack",
        "title": "ParcelContext: Export Context Pack",
        "icon": "$(export)"
      },
      {
        "command": "parcelcontext.importPack",
        "title": "ParcelContext: Import Context Pack",
        "icon": "$(cloud-download)"
      },
      {
        "command": "parcelcontext.sharePack",
        "title": "ParcelContext: Share Context Pack",
        "icon": "$(link)"
      },
      {
        "command": "parcelcontext.toggleForWorkspace",
        "title": "ParcelContext: Enable/Disable Pack for This Workspace",
        "icon": "$(check)"
      },
      {
        "command": "parcelcontext.showPack",
        "title": "ParcelContext: Show Pack Details"
      },
      {
        "command": "parcelcontext.deletePack",
        "title": "ParcelContext: Delete Context Packs",
        "icon": "$(trash)"
      },
      {
        "command": "parcelcontext.refresh",
        "title": "ParcelContext: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "parcelcontext.searchPacks",
          "when": "view == parcelcontext.library",
          "group": "navigation@1"
        },
        {
          "command": "parcelcontext.newPack",
          "when": "view == parcelcontext.library",
          "group": "navigation@2"
        },
        {
          "command": "parcelcontext.selectModel",
          "when": "view == parcelcontext.library",
          "group": "navigation@3"
        },
        {
          "command": "parcelcontext.refresh",
          "when": "view == parcelcontext.library",
          "group": "navigation@4"
        },
        {
          "command": "parcelcontext.scanPacks",
          "when": "view == parcelcontext.library",
          "group": "1_create@1"
        },
        {
          "command": "parcelcontext.buildPackFromTopic",
          "when": "view == parcelcontext.library",
          "group": "1_create@2"
        },
        {
          "command": "parcelcontext.savePack",
          "when": "view == parcelcontext.library",
          "group": "1_create@3"
        },
        {
          "command": "parcelcontext.importPack",
          "when": "view == parcelcontext.library",
          "group": "1_create@4"
        },
        {
          "command": "parcelcontext.mergePacks",
          "when": "view == parcelcontext.library",
          "group": "2_library@1"
        },
        {
          "command": "parcelcontext.deletePack",
          "when": "view == parcelcontext.library",
          "group": "2_library@2"
        },
        {
          "command": "parcelcontext.showVersion",
          "when": "view == parcelcontext.library",
          "group": "9_help@1"
        }
      ],
      "view/item/context": [
        {
          "command": "parcelcontext.toggleForWorkspace",
          "when": "view == parcelcontext.library && viewItem == pack",
          "group": "inline@1"
        },
        {
          "command": "parcelcontext.exportPack",
          "when": "view == parcelcontext.library && viewItem == pack",
          "group": "inline@2"
        },
        {
          "command": "parcelcontext.refreshPack",
          "when": "view == parcelcontext.library && viewItem == pack",
          "group": "inline@3"
        },
        {
          "command": "parcelcontext.sharePack",
          "when": "view == parcelcontext.library && viewItem == pack",
          "group": "1_actions@1"
        },
        {
          "command": "parcelcontext.splitPack",
          "when": "view == parcelcontext.library && viewItem == pack",
          "group": "1_actions@2"
        },
        {
          "command": "parcelcontext.mergePacks",
          "when": "view == parcelcontext.library && viewItem == pack",
          "group": "1_actions@3"
        },
        {
          "command": "parcelcontext.deletePack",
          "when": "view == parcelcontext.library && viewItem == pack",
          "group": "9_danger@1"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "parcelcontext_getContext",
        "displayName": "Context Packs",
        "modelDescription": "Retrieves reviewed context packs that the user has explicitly enabled for this workspace. A context pack contains user-selected, user-reviewed knowledge such as project goals, decisions, conventions and open questions. Use this when the user asks about project background, prior decisions, team conventions, or how to approach work in this repository. Only returns content the user chose to include and enabled here; it does not access chat history or any external system.",
        "userDescription": "Reviewed context packs you enabled for this workspace",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "contextPacks",
        "icon": "$(library)",
        "tags": [
          "parcelcontext",
          "context"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Optional keywords to narrow which enabled packs and sections are returned."
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test out/test/parse.test.js out/test/draft.test.js out/test/scan.test.js out/test/workspace.test.js out/test/search.test.js",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
